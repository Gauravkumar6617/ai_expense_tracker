  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "curreny": {
          "type": "string",
          "example": "USD"
        },
        "created_at": {
          "type": "string",
          "example": "2026-06-21T10:00:00.000Z"
        }
      }
    },
    "RegisterRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "hash_password": {
          "type": "string",
          "example": "secret123"
        },
        "curreny": {
          "type": "string",
          "example": "USD"
        }
      },
      "required": [
        "name",
        "email",
        "hash_password"
      ]
    },
    "LoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "hash_password": {
          "type": "string",
          "example": "secret123"
        }
      },
      "required": [
        "email",
        "hash_password"
      ]
    },
    "AuthResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/User"
        },
        "token": {
          "type": "string",
          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
        }
      }
    },
    "Category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "example": 1
        },
        "user_id": {
          "type": "number",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Food"
        },
        "type": {
          "type": "string",
          "example": "expense"
        },
        "icon": {
          "type": "string",
          "example": "🍔"
        },
        "color": {
          "type": "string",
          "example": "#FF5733"
        },
        "is_default": {
          "type": "boolean",
          "example": false
        }
      }
    },
    "AddCategoryRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Groceries"
        },
        "type": {
          "type": "string",
          "example": "expense"
        },
        "icon": {
          "type": "string",
          "example": "🛒"
        },
        "color": {
          "type": "string",
          "example": "#4CAF50"
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "UpdateCategoryRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Dining Out"
        },
        "type": {
          "type": "string",
          "example": "expense"
        },
        "icon": {
          "type": "string",
          "example": "🍽️"
        },
        "color": {
          "type": "string",
          "example": "#E91E63"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Something went wrong"
        }
      }
    }
  }
